<Defs>

	<!--PURCHASE GRAVLITE PANELS-->

	<RecipeDef ParentName="MLRP_NebulaVeilBase">
		<defName>MLRP_NV_GravlitePanels</defName>
		<label>purchase gravlite panels</label>
		<description>Offer silver in exchange for 50 gravlite panels.\n\nThe price includes the cost of the materials you'd normally use to make them.</description>
		<researchPrerequisite>AdvancedGravtech</researchPrerequisite>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Silver</li>
					</thingDefs>
				</filter>
				<count>132</count>
			</li>
		</ingredients>
		<products>
			<GravlitePanel>50</GravlitePanel>
		</products>
	</RecipeDef>
	
	<!--PURCHASE SHUTTLE ENGINE-->
	
	<RecipeDef ParentName="MLRP_NebulaVeilBase">
		<defName>MLRP_NV_ShuttleEngine</defName>
		<label>purchase shuttle engine</label>
		<description>Offer silver in exchange for a shuttle engine.\n\nDue to the scarcity of this item, Nebula will only sell it to someone who can explain how it works.</description>
		<researchPrerequisite>Shuttles</researchPrerequisite>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Silver</li>
					</thingDefs>
				</filter>
				<count>350</count>
			</li>
		</ingredients>
		<products>
			<ShuttleEngine>1</ShuttleEngine>
		</products>
		<skillRequirements>
			<Intellectual>12</Intellectual>
		</skillRequirements>
	</RecipeDef>
	
	<!--PURCHASE SENTIENCE CATALYST-->
	
	<RecipeDef ParentName="MLRP_NebulaVeilBase">
		<defName>MLRP_NV_SentienceCatalyst</defName>
		<label>purchase sentience catalyst</label>
		<description>Offer silver in exchange for a sentience catalyst.\n\nDue to how easy this item is to acquire, Nebula insists on having a quick chat before she'll sell it to you.</description>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Silver</li>
					</thingDefs>
				</filter>
				<count>50</count>
			</li>
		</ingredients>
		<products>
			<SentienceCatalyst>1</SentienceCatalyst>
		</products>
		<skillRequirements>
			<Social>5</Social>
		</skillRequirements>
	</RecipeDef>
	
	<!--PURCHASE PILOT ASSISTANT-->
	
	<RecipeDef ParentName="MLRP_NebulaVeilBase">
		<defName>MLRP_NV_PilotAssistant</defName>
		<label>purchase pilot assistant</label>
		<description>Offer silver in exchange for a pilot assistant.\n\nNebula will expect you to show some knowledge of piloting before she will sell it to you.</description>
		<researchPrerequisite>AdvancedGravtech</researchPrerequisite>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Silver</li>
					</thingDefs>
				</filter>
				<count>75</count>
			</li>
		</ingredients>
		<products>
			<PilotAssistant>1</PilotAssistant>
		</products>
		<skillRequirements>
			<Intellectual>8</Intellectual>
		</skillRequirements>
	</RecipeDef>
	
	<!--PURCHASE VACSKIN GLAND-->
	
	<RecipeDef ParentName="MLRP_NebulaVeilBase">
		<defName>MLRP_NV_VacskinGland</defName>
		<label>purchase vacskin gland</label>
		<description>Offer silver in exchange for a neurocalculator.\n\nNebula asks that you provide the materials normally used to make one, as well as tell her a story about your orbital adventures (she doesn't care if you make one up).</description>
		<researchPrerequisite>SkinHardening</researchPrerequisite>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Silver</li>
					</thingDefs>
				</filter>
				<count>155</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Plasteel</li>
					</thingDefs>
				</filter>
				<count>15</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentSpacer</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
		</ingredients>
		<products>
			<VacskinGland>1</VacskinGland>
		</products>
		<skillRequirements>
			<Social>5</Social>
		</skillRequirements>
	</RecipeDef>
	
</Defs>