<Patch>

	<!--CORE SCENARIO-->
	
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>[MLP] My Little RimPony - Medieval Overhaul Patches</li>
		</mods>
		<nomatch Class="PatchOperationReplace">
			<xpath>Defs/ScenarioDef[defName="MLRP_Scenario"]/scenario/parts/li[@Name="MLRP_CoreScenario_Helmets"]</xpath>
			<value>
				<li Class="ScenPart_StartingThing_Defined" Name="MLRP_CoreScenario_Helmets">
					<def>StartingThing_Defined</def>
					<thingDef>Apparel_AdvancedHelmet</thingDef>
					<count>3</count>
				</li>
			</value>
		</nomatch>
	</Operation>
	
	<!--BIOTECH SCENARIO-->
	
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Biotech</li>
		</mods>
		<match Class="PatchOperationFindMod">
			<mods>
				<li>[MLP] My Little RimPony - Medieval Overhaul Patches</li>
			</mods>
			<nomatch Class="PatchOperationReplace">
				<xpath>Defs/ScenarioDef[defName="MLRP_Scenario_Xenos"]/scenario/parts/li[@Name="MLRP_BiotechScenario_Helmets"]</xpath>
				<value>
					<li Class="ScenPart_StartingThing_Defined" Name="MLRP_BiotechScenario_Helmets">
						<def>StartingThing_Defined</def>
						<thingDef>Apparel_AdvancedHelmet</thingDef>
						<count>5</count>
					</li>
				</value>
			</nomatch>
		</match>
	</Operation>
	
	<!--RENEGADE ALICORN SCENARIO-->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Biotech</li>
		</mods>
		<match Class="PatchOperationFindMod">
			<mods>
				<li>[MLP] My Little RimPony - Medieval Overhaul Patches</li>
			</mods>
			<nomatch Class="PatchOperationReplace">
				<xpath>Defs/ScenarioDef[defName="MLRP_Scenario_Xenos"]/scenario/parts/li[@Name="MLRP_RAScenario_Helmets"]</xpath>
				<value>
					<li Class="ScenPart_StartingThing_Defined" Name="MLRP_RAScenario_Helmets">
						<def>StartingThing_Defined</def>
						<thingDef>Apparel_AdvancedHelmet</thingDef>
						<count>4</count>
					</li>
				</value>
			</nomatch>
		</match>
	</Operation>

</Patch>