<Patch>

	<!--Add bulk and worn bulk to plushies-->

	<Operation Class="PatchOperationAdd">
	    <xpath>/Defs/ThingDef[@Name="PonyPlushBase"]/statBases</xpath>
	    <value>
			<Bulk>0.1</Bulk>
			<WornBulk>0.1</WornBulk>
	    </value>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
	    <xpath>/Defs/ThingDef[defName="PonyPlush_Ruined"]/statBases</xpath>
	    <value>
			<Bulk>0.1</Bulk>
	    </value>
	</Operation>
		
	<!--Shining Armour-->
	
	<Operation Class="PatchOperationReplace">
	    <xpath>/Defs/ThingDef[defName="PonyPlush_ShiningArmour"]/equippedStatOffsets</xpath>
	    <value>
		<equippedStatOffsets>
			<ArmorRating_Blunt>5</ArmorRating_Blunt>
			<ArmorRating_Sharp>5</ArmorRating_Sharp>
			<ArmorRating_Heat>0.3</ArmorRating_Heat>
		</equippedStatOffsets>
	    </value>
	</Operation>
	
	<!--<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="PonyPlush_ShiningArmour"]/apparel/bodyPartGroups</xpath>
		<value>
			<li>Torso</li>
		</value>
	</Operation>-->
	
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Biotech</li>
		</mods>
		<match Class="PatchOperationReplace">
			<xpath>/Defs/ThingDef[defName="PonyPlush_ShiningArmour_Child"]/equippedStatOffsets</xpath>
			<value>
			<equippedStatOffsets>
				<ArmorRating_Blunt>10</ArmorRating_Blunt>
				<ArmorRating_Sharp>10</ArmorRating_Sharp>
				<ArmorRating_Heat>0.6</ArmorRating_Heat>
			</equippedStatOffsets>
			</value>
		</match>
	</Operation>
	
	<!--<Operation Class="PatchOperationAdd" MayRequire="Ludeon.RimWorld.Biotech">
		<xpath>/Defs/ThingDef[defName="PonyPlush_ShiningArmour_Child"]/apparel/bodyPartGroups</xpath>
		<value>
			<li>Torso</li>
		</value>
	</Operation>-->
	
	<!--Harmony Chip (Requires Royalty DLC)-->
	
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Royalty</li>
		</mods>
			<match Class="PatchOperationReplace">
			<xpath>/Defs/HediffDef[defName="MLRP_HarmonyChipInstalled"]/stages/li/statOffsets/ArmorRating_Blunt</xpath>
			<value>
				<ArmorRating_Blunt>5</ArmorRating_Blunt>
			</value>
		</match>
	</Operation>
	
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Royalty</li>
		</mods>
		<match Class="PatchOperationReplace">
			<xpath>/Defs/HediffDef[defName="MLRP_HarmonyChipInstalled"]/stages/li/statOffsets/ArmorRating_Sharp</xpath>
			<value>
				<ArmorRating_Sharp>5</ArmorRating_Sharp>
			</value>
		</match>
	</Operation>
	
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Royalty</li>
		</mods>
		<match Class="PatchOperationReplace">
			<xpath>/Defs/HediffDef[defName="MLRP_HarmonyChipInstalled"]/stages/li/statOffsets/ArmorRating_Heat</xpath>
			<value>
				<ArmorRating_Heat>0.3</ArmorRating_Heat>
			</value>
		</match>
	</Operation>
	
</Patch>